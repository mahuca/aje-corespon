# Configuración de Aje-Corespon
# Copiar a .env y editar los valores

# Puerto del servidor
PORT=3001

# Zona horaria (fechas de las notificaciones)
TZ=Europe/Madrid

# URL pública de la aplicación (recomendado en producción).
# Se usa en los enlaces de las notificaciones. Si no se define, se deduce de
# la petición (Host y X-Forwarded-Proto).
# BASE_URL=https://aje-corespon.onrender.com

# Base de datos PostgreSQL (Neon recomendado)
# DATABASE_URL=postgresql://usuario:password@host:5432/dbname?sslmode=require

# ============================ NOTIFICACIONES ============================
# Proveedor: telegram (recomendado), meta, twilio o sendgrid.
# Si no se indica y existe TELEGRAM_BOT_TOKEN, se usa Telegram.
# NOTIFY_PROVIDER=telegram

# --- Telegram ---
# 1. Habla con @BotFather, crea un bot y copia el token.
# 2. Crea un grupo (o usa uno existente), añade el bot y dale permiso para
#    escribir. El chat_id del grupo empieza por "-" (p. ej. -1001234567890).
#    Para obtenerlo: envía un mensaje al grupo y consulta
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Opcional: un chat privado por jugador con TELEGRAM_CHAT_<JUGADOR>.
#    Si no existe, el mensaje va al grupo.
TELEGRAM_BOT_TOKEN=123456789:AAEjemploDeTokenDeBotFather
TELEGRAM_CHAT_ID=-1001234567890

# Chats privados opcionales (tienen prioridad sobre el grupo)
# TELEGRAM_CHAT_MANUEL=123456789
# TELEGRAM_CHAT_FERNAN=987654321
# TELEGRAM_CHAT_ABUELO=555555555

# --- WhatsApp - Meta Cloud API ---
# NOTIFY_PROVIDER=meta
# WHATSAPP_TOKEN=tu_token_de_meta
# WHATSAPP_PHONE_ID=tu_phone_id_de_meta

# --- WhatsApp - Twilio ---
# NOTIFY_PROVIDER=twilio
# WHATSAPP_ACCOUNT_SID=tu_account_sid
# WHATSAPP_AUTH_TOKEN=tu_auth_token
# WHATSAPP_FROM=+1234567890
# WHATSAPP_TO=+1234567890

# --- Visibilidad de la cola ---
# Protege GET /api/whatsapp/queue (pendiente/enviado/fallido). Si no se define,
# el endpoint queda abierto: defínelo en producción.
# ADMIN_TOKEN=cambia_esto_por_un_secreto_largo

# --- Desarrollo: volcar los mensajes a archivos locales ---
# NOTIFY_PROVIDER=sendgrid
# SENDGRID_API_KEY=tu_api_key
# WHATSAPP_FALLBACK_DIR=/tmp/whatsapp-fallback

# Conexión a PostgreSQL
PG_POOL_MAX=4
